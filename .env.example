# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env  (Windows)

# Nome da aplicação (aparece na doc do Swagger):
APP_NAME=NPET API

# Ambiente de execução: DEV, QAS, PRD:
APP_ENV=development

# Porta usada pelo servidor Uvicorn:
PORT=8000

# Prefixo base de todas as rotas da API:
API_PREFIX=/api/v1

# Habilita comportamentos de depuração (logs mais verbosos, etc.):
DEBUG=true
